# ---------------------------------------------------------------
# APEX — example environment configuration
#
# Copy to .env and fill in real values for local development:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets, keys or tokens.
# ---------------------------------------------------------------

# --- Application ------------------------------------------------
APEX_ENV=development
APEX_DEBUG=true
APEX_LOG_LEVEL=INFO
APEX_API_PREFIX=/api/v1

# --- Backend service --------------------------------------------
APEX_BACKEND_HOST=0.0.0.0
APEX_BACKEND_PORT=8000

# --- Frontend service -------------------------------------------
# Base URL the browser uses to reach the APEX API.
VITE_APEX_API_BASE_URL=http://localhost:8000/api/v1

# --- PostgreSQL -------------------------------------------------
# These configure the postgres container itself.
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=apex
POSTGRES_HOST=postgres
# Host port the container publishes on. Change this if a PostgreSQL is already
# installed on the machine -- otherwise both bind 5432, and connections from
# the host silently reach the wrong server with a confusing auth failure.
POSTGRES_PORT=5432

# The URL the backend and Alembic both use. Under Docker Compose this is
# assembled from the POSTGRES_* values above and overridden automatically,
# so the credentials have a single source of truth. The value here is the
# one used when running the backend directly on the host.
APEX_DATABASE_URL=postgresql+psycopg://apex:change-me-in-your-local-env@localhost:5432/apex

# Connection pool
APEX_DB_POOL_SIZE=5
APEX_DB_MAX_OVERFLOW=10
APEX_DB_POOL_TIMEOUT=30
APEX_DB_POOL_RECYCLE=1800
APEX_DB_ECHO=false

# --- Object storage, S3-compatible ------------------------------
# Under Docker Compose the endpoint is overridden to the service name.
# The value here is what the backend uses when run directly on the host.
APEX_S3_ENDPOINT=http://localhost:9000
APEX_S3_ACCESS_KEY=change-me-in-your-local-env
APEX_S3_SECRET_KEY=change-me-in-your-local-env
APEX_S3_BUCKET=apex-objects
APEX_S3_REGION=us-east-1
# Path-style addressing is required by MinIO and most S3-compatible servers.
# AWS S3 itself wants virtual-host style, so set this false there.
APEX_S3_FORCE_PATH_STYLE=true

# Host ports the MinIO container publishes. Change these if something already
# occupies them -- see the PostgreSQL note above for why that matters.
APEX_S3_PORT=9000
APEX_S3_CONSOLE_PORT=9001

# Storage limits and policy
APEX_STORAGE_MAX_OBJECT_BYTES=104857600
APEX_STORAGE_SIGNED_URL_TTL_SECONDS=300
# Empty means "allow any type". Set an explicit comma-separated allowlist to
# restrict what may be stored.
APEX_STORAGE_ALLOWED_CONTENT_TYPES=

# --- Identity / authentication (wired up in Commit 004) ---------
# Generate a real value, e.g.: openssl rand -hex 32
APEX_JWT_SECRET=change-me-in-your-local-env
APEX_JWT_ALGORITHM=HS256
APEX_ACCESS_TOKEN_TTL_MINUTES=30

# --- CORS -------------------------------------------------------
APEX_CORS_ORIGINS=http://localhost:5173

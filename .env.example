# ---------------------------------------------------------------
# APEX — example environment configuration
#
# Copy to .env and fill in real values for local development:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets, keys or tokens.
# ---------------------------------------------------------------

# --- Application ------------------------------------------------
APEX_ENV=development
APEX_DEBUG=true
APEX_LOG_LEVEL=INFO
APEX_API_PREFIX=/api/v1

# --- Backend service --------------------------------------------
APEX_BACKEND_HOST=0.0.0.0
APEX_BACKEND_PORT=8000

# --- Frontend service -------------------------------------------
# Base URL the browser uses to reach the APEX API.
VITE_APEX_API_BASE_URL=http://localhost:8000/api/v1

# --- PostgreSQL (wired up in Commit 003) ------------------------
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me-in-your-local-env
POSTGRES_DB=apex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Object storage, S3-compatible (wired up in Commit 008) -----
APEX_S3_ENDPOINT=http://minio:9000
APEX_S3_ACCESS_KEY=change-me-in-your-local-env
APEX_S3_SECRET_KEY=change-me-in-your-local-env
APEX_S3_BUCKET=apex-assets
APEX_S3_REGION=us-east-1

# --- Identity / authentication (wired up in Commit 004) ---------
# Generate a real value, e.g.: openssl rand -hex 32
APEX_JWT_SECRET=change-me-in-your-local-env
APEX_JWT_ALGORITHM=HS256
APEX_ACCESS_TOKEN_TTL_MINUTES=30

# --- CORS -------------------------------------------------------
APEX_CORS_ORIGINS=http://localhost:5173

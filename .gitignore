# ---------------------------------------------------------------
# APEX — ignored paths
# Secrets, build output, dependencies and local tooling state.
# ---------------------------------------------------------------

# Secrets and local configuration -- never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and OS
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local data volumes and object storage
.data/
postgres-data/
minio-data/
uploads/

# Logs
*.log
logs/
